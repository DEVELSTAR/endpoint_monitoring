				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"endpoint_monitoring_group\": {\n    \"name\": \"Entertainment\",\n    \"group_type\": \"network\",\n    \"associated_resources\": [\n      \"AP:1\",\n      \"network:9\",\n      \"tag:1\"\n    ],\n    \"endpoint_monitoring_endpoints_attributes\": [\n      {\n        \"name\": \"Google\",\n        \"host\": \"google.com\",\n        \"monitoring_mode\": \"icmp\",\n        \"latency_warning\": 80,\n        \"latency_critical\": 250\n      },\n      {\n        \"name\": \"StackOverflow\",\n        \"host\": \"http://stackoverflow.com\",\n        \"monitoring_mode\": \"http\",\n        \"response_time\": 250,\n        \"acceptable_response_codes\": [\n          200,\n          204\n        ]\n      },\n      {\n        \"name\": \"Redis\",\n        \"host\": \"redis.example.net\",\n        \"monitoring_mode\": \"tcp\",\n        \"port\": 6379\n      }\n    ]\n  }\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
